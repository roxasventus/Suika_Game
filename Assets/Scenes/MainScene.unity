--- !u!114 &1180224780
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1180224776}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f585d9ba6a086e44296e4ad35698a839, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HowtoPlay
  explainContents:
  - "\uC790, \uC798 \uB4E4\uC5B4.\\n\uC9C0\uAE08 \uB124\uAC00 \uC11C \uC788\uB294
    \uACF3\uC740 \uC6B0\uB9AC \uD68C\uC0AC \uC18C\uC720\uC758 <size=115%><color=#AAAAAA>\uAD11\uC0B0</color></size>\uC774\uB2E4.\\n\uB0A1\uC558\uACE0,
    <size=115%><color=#FF5555>\uACE7 \uBB34\uB108\uC9C8 \uC608\uC815</color></size>\uC774\uB2E4.\\n\\n\uD558\uC9C0\uB9CC
    \uB124\uAC00 \uC2E0\uACBD \uC4F8 \uAC74 \uAC04\uB2E8\uD574."
  - "<size=120%><color=#FFD700>\uAD11\uC0B0 \uC548\uC5D0\uC11C \uC810\uC218\uB97C
    \uBC8C\uACE0</color></size>,\\n<size=120%><color=#00FFAA>\uC81C\uD55C\uC2DC\uAC04
    \uC548\uC5D0 \uCD9C\uAD6C\uB85C \uD0C8\uCD9C</color></size>\uD574\uB77C.\\n\\n\uB458
    \uC911 \uD558\uB098\uB77C\uB3C4 \uBABB \uD558\uBA74?\\n<color=#AAAAAA>\uC74C\u2026
    \uB2E4\uC74C \uC778\uB825\uC774 \uC774\uC5B4\uC11C \uD558\uACA0\uC9C0.</color>"
  - "\uB108\uC758 \uBAA9\uD45C\uB294 \uB450 \uAC00\uC9C0\uB2E4.\\n\\n<size=120%><color=#FFD700>\uCD1D
    \uC810\uC218 10,000\uC810 \uC774\uC0C1</color></size>\uC744 \uCC44\uC6B0\uACE0,\\n<size=120%><color=#00FFAA>\uC81C\uD55C\uC2DC\uAC04
    \uB0B4 \uD0C8\uCD9C</color></size>\uC5D0 \uC131\uACF5\uD558\uBA74 \uC0DD\uC874\uC774\uB2E4.\\n\\n\uC810\uC218\uB9CC
    \uB192\uACE0 \uBABB \uB098\uAC00\uB3C4 <size=115%><color=#FF5555>\uB05D</color></size>,\\n\uBE68\uB9AC
    \uB098\uAC00\uB3C4 \uC810\uC218\uAC00 \uBD80\uC871\uD558\uBA74 <size=115%><color=#FF5555>\uB05D</color></size>\uC774\uB2E4.\\n<color=#AAAAAA>\uD68C\uC0AC\uB294
    \uACB0\uACFC\uB85C \uB9D0\uD558\uB2C8\uAE4C.</color>"
  - "\uC870\uC791\uC740 \uB2E8\uC21C\uD558\uB2E4.\\n<size=110%><color=#DDDDDD>WASD</color></size>
    \uB610\uB294 <size=110%><color=#DDDDDD>\uBC29\uD5A5\uD0A4</color></size>\uB85C
    \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4.\\n\uADF8\uB9AC\uACE0 <size=110%><color=#FFD700>Shift</color></size>\uB85C
    \uAC00\uC18D\uC774 \uAC00\uB2A5\uD558\uB2E4.\\n\\n\uB2E4\uB9CC \uAC00\uC18D\uC744
    \uB108\uBB34 \uC624\uB798 \uC4F0\uBA74\\n\uC7A5\uBE44\uAC00 <size=115%><color=#FF5555>\uACFC\uC5F4</color></size>\uB418\uC5B4\\n\uC7A0\uC2DC
    \uB3D9\uC548 <size=110%><color=#FF5555>\uAC00\uC18D\uC744 \uBABB \uD558\uAC8C
    \uB41C\uB2E4</color></size>.\\n\\n<color=#AAAAAA>\uD68C\uC0AC \uC7A5\uBE44\uB294
    \uC18C\uC911\uD558\uB2C8\uAE4C</color> \uC870\uC2EC\uD788 \uC0AC\uC6A9\uD558\uB3C4\uB85D.\\n<color=#AAAAAA>(\uC7A5\uBE44
    \uD558\uB098\uAC00 \uC778\uB825 \uD558\uB098\uBCF4\uB2E4 \uB354 \uC911\uC694\uD558\uB124.)</color>"
  - "\uAD11\uBB3C\uC740 \uBC18\uC751\uC131\uC774 \uC88B\uB2E4.\\n\\n\uAC19\uC740
    \uC885\uB958\uC758 \uAD11\uBB3C\uB07C\uB9AC \uB2FF\uC73C\uBA74\\n\uC989\uC2DC
    \uD569\uC131\uB418\uC5B4 <size=115%><color=#FFD700>\uC0C1\uC704 \uAD11\uBB3C</color></size>\uC774
    \uC0DD\uC131\uB41C\uB2E4.\\n\\n\uC0C1\uC704 \uAD11\uBB3C\uC77C\uC218\uB85D\\n<size=115%><color=#FFD700>\uC810\uC218</color></size>\uAC00
    \uD06C\uB2E4.\\n\\n\uC791\uC740 \uAC78 \uB9CE\uC774 \uBAA8\uC73C\uB4E0,\\n\uD070
    \uAC78 \uB178\uB9AC\uB4E0 \uC0C1\uAD00\uC5C6\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uD558\uB098 \uB354. \\n\\n\uAD11\uC0B0 \uC548\uC5D0\uB294\\n<size=115%><color=#FFAA00>\uB2E4\uC774\uB108\uB9C8\uC774\uD2B8</color></size>\uAC00
    \uC788\uB2E4.\\n\\n \uD130\uC9C4\uB2E4\uACE0 \uD574\uC11C \uAD11\uBB3C\uC774\\n<color=#AAAAAA>\uC0AC\uB77C\uC9C0\uC9C0\uB294
    \uC54A\uB294\uB2E4</color>.\\n\uD558\uC9C0\uB9CC \uD3ED\uBC1C \uCDA9\uACA9\uC73C\uB85C\\n\uAD11\uBB3C\uC774
    <size=115%><color=#FF5555>\uD295\uACA8 \uB098\uAC00</color></size>\\n\uC544\uB798\uB85C
    <size=115%><color=#FF5555>\uB5A8\uC5B4\uC9C8 \uC218</color></size> \uC788\uB2E4.\\n\\n
    <color=#AAAAAA>\uC815\uB9AC\uD574\uBCF4\uBA74, \uC190\uD574\uB294 \uB124\uAC00
    \uBCF8\uB2E4.</color>"
  - "<size=120%><color=#FFD700>\uC810\uC218 10,000 \uC774\uC0C1</color></size>\uB9CC
    \uCC44\uC6B0\uACE0,\\n<size=120%><color=#00FFAA>\uC2DC\uAC04 \uC548\uC5D0</color></size>
    \uB098\uC640\uB77C.\\n\\n\uB9C8\uC9C0\uB9C9 \uACBD\uACE0\uB2E4.\\n\uB9DD\uC124\uC774\uB2E4\uAC00
    <size=115%><color=#FFAA00>\uD0C8\uCD9C \uD0C0\uC774\uBC0D</color></size>\uC744
    \uB193\uCE58\uC9C0 \uB9C8\uB77C.\\n\\n\uC810\uC218 \uC695\uC2EC\uC5D0 \uAD11\uC0B0\uC774
