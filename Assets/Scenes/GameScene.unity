--- !u!114 &1239418253
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1239418250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9042f6c9753bec840be616a0761a734b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  _isPlay: 1
  _isClear: 0
  _player: {fileID: 1020727480}
  _maxDistance: 500
  _distance: 0
  _time: 120
  _clearPrice: 15000
  _totalPrice: 0
  _exitBackground: {fileID: 100992626}
  clearText:
  - "\u201C\uADF8\uB798\uB3C4 \uC0B4\uC544\uB0A8\uC558\uB124? \uD6CC\uB96D\uD574.\u201D\\n\u201C\uC774\uBC88
    \uB2EC \uC778\uAC74\uBE44\uB294\u2026 \uC870\uAE08\uB9CC \uB354 \uAE4E\uC544\uB3C4
    \uB418\uACA0\uC5B4.\u201D"
  - "\u201C\uAD11\uC0B0\uC774 \uBB34\uB108\uC84C\uB2E4\uACE0?\u201D\\n\u201C\uD558\uD558,
    \uADF8\uB7FC \uB2E4\uC74C \uAD11\uC0B0\uC73C\uB85C \uAC00\uBA74 \uB418\uC9C0.\u201D"
  - "\u201C\uC131\uACFC\uB294 \uC778\uC815\uD558\uC9C0.\u201D\\n\u201C\uD558\uC9C0\uB9CC
    \uBCF4\uB108\uC2A4\uB294 \uB2E4\uC74C \uBD84\uAE30\uC5D0 \uAC80\uD1A0\uD558\uB3C4\uB85D
    \uD558\uC9C0.\u201D"
  - "\u201C\uC774 \uC815\uB3C4\uB85C \uB9CC\uC871\uD558\uBA74 \uACE4\uB780\uD574.\u201D\\n\u201C\uD68C\uC0AC\uC5D4
    \uC544\uC9C1 \uB0A8\uC740 \uAD11\uB9E5\uC774 \uB9CE\uAC70\uB4E0.\u201D"
  - "\u201C\uC624\uB298\uB3C4 \uBB34\uC0AC\uD788 \uD1F4\uADFC\uD588\uAD70.\u201D\\n\u201C\uBB3C\uB860,
    \u2018\uBB34\uC0AC\uD788\u2019\uC758 \uAE30\uC900\uC740 \uD68C\uC0AC \uAE30\uC900\uC774\uC9C0\uB9CC.\u201D"
  failText:
  - "\u201C\uC544, \uBD95\uAD34\uB410\uB098?\u201D\\n\u201C\uAC71\uC815 \uB9C8, \uB300\uCCB4
    \uC778\uB825\uC740 \uCDA9\uBD84\uD574.\u201D"
  - "\u201C\uC774\uB7F0 \uACB0\uACFC\uB294 \uC608\uC0C1 \uBC94\uC704\uC57C.\u201D\\n\u201C\uBCF4\uACE0\uC11C\uC5D4
    \u2018\uAC1C\uC778 \uACFC\uC2E4\u2019\uB85C \uC801\uC5B4\uB450\uC9C0.\u201D"
  - "\u201C\uC0B0\uC7AC \uCC98\uB9AC\uB294 \uC5B4\uB835\uACA0\uC5B4.\u201D\\n\u201C\uC11C\uB958\uAC00\u2026
    \uC5C6\uC796\uC544?\u201D"
  - "\u201C\uC774 \uC815\uB3C4 \uC704\uD5D8\uC740 \uAC10\uC218\uD574\uC57C\uC9C0.\u201D\\n\u201C\uADF8\uAC8C
    \uBC14\uB85C \u2018\uACBD\uD5D8\u2019\uC774\uB2C8\uAE4C.\u201D"
  - " \u201C\uB2E4\uC74C\uC5D4 \uB354 \uC798\uD574\uBCF4\uAC8C.\u201D\\n\u201C\uBB3C\uB860,
    \uB2E4\uC74C\uC774 \uC788\uB2E4\uBA74 \uB9D0\uC774\uC9C0.\u201D"
